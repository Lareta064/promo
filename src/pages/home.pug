extends /pug/layouts/layout.pug

block content
	.page-content
		include /pug/sections/_header.pug
		main.main-content
			.container
				.main-grid
					.main-left
						.main-large-image
						.main-left-grid
							.image-top
								p.main-left-title We are sincerely grateful to our sponsors for standing by us
								img(src='./img/1.png', srcset='./img/1@2x.png 2x' width='593' height='295' loading='lazy' alt='img')
							.image-left
								img(src='./img/2.png', srcset='./img/2@2x.png 2x' width='275' height='243' loading='lazy' alt='img')
							.image-right
								img(src='./img/3.png', srcset='./img/3@2x.png 2x' width='310' height='243' loading='lazy' alt='img')
					
							.partners-banner
								.partners-banner__img
									img(src='./img/Icon.png', srcset='./img/Icon@2x.png 2x' width='55' height='55' loading='lazy' alt='img')
								.partners-banner__text
									.partners-banner__title Your brand here
									p.font-18 Space available —<br>promote your project now!

					.main-right
						.widgets-wrapper(style="background-image: url(./img/bg.png)")
							.widgets-wrapper__title Look at the conditions your friends train in — impressive!
							.widgets-list.none
								//single
								.widget-single
									.widget-display
										.widget-content
									
									.widgets-list-form
										.widget-input
											input(type="text" name="widget1")
										.widget-name Define FAA location identifier: SFO, JFK, LAX, SFO, JFK, LAX
		
								//single
								.widget-single
									.widget-display
										.widget-content
									
									.widgets-list-form
										.widget-input
											input(type="text" name="widget1")
										.widget-name Define FAA location identifier: SFO, JFK, LAX, SFO, JFK, LAX		

						//bottom
						.widget-bottom
							p For someone who intend to quickly obtain a license to control Twin 

			
block variables
	-var title = "Project";
