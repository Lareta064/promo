extends /pug/layouts/layout.pug
block content
	.page-content
		include /pug/sections/_header.pug
		main.main-content
			.container
				.main-grid
					.main-left
						.main-large-image
						.main-left-grid
							.image-top(data-dynamic-move=".main-large-image, 768")
								p.main-left-title We are sincerely grateful to our sponsors for standing by us
								img(src='./img/1.png', srcset='./img/1@2x.png 2x' width='593' height='295' loading='lazy' alt='img')
							.image-left
								img(src='./img/2.png', srcset='./img/2@2x.png 2x' width='275' height='243' loading='lazy' alt='img')
							.image-right
								img(src='./img/3.png', srcset='./img/3@2x.png 2x' width='310' height='243' loading='lazy' alt='img')
						.partners-banner-wrapper
							.partners-banner
								.partners-banner__img
									img(src='./img/Icon.png', srcset='./img/Icon@2x.png 2x' width='55' height='55' loading='lazy' alt='img')
								.partners-banner__text
									.partners-banner__title Your brand here
									p.font-18 Space available —<br>promote your project now!

					.main-right
						article.article
							header.article__header
								h1.article__title Critical Engine Failure Twin Engine: What Pilots Actually Do
								.article__reading-time
									svg.article__reading-time-icon(viewBox="0 0 24 24" fill="none" aria-hidden="true")
										circle(cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5")
										path(d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
									span.article__reading-time-text 12 minutes
								nav.article__breadcrumbs(aria-label="Breadcrumbs")
									a.article__breadcrumb-link(href="/library.html") Aviation history
									span.article__breadcrumb-separator /
									span.article__breadcrumb-current Critical Engine Failure Twin Engine: What Pilots Actually Do

